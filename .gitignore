# ==============================================================================
# Roomly Project Gitignore
# ==============================================================================

# --- Sensitive Configuration (NEVER COMMIT THESE) ---
.env
.env.local
.env.*
server-rpi/config.json
server-win/config.json
*.db
*.sqlite
*.sqlite3

# --- Repository Snapshots (Security Risk) ---
repomix-output.xml
repomix-output.txt
repomix-output.json

# --- Backups and Archives ---
archive/
**/archive/
*- Copy/
*.zip
*.bk
*.bkp
config_backup_*.json
config_bkp.json

# --- Dependencies and Build Outputs ---
node_modules/
dist/
out/
build/
release/
release*/
app-builds/
app-builds*/
.venv/
venv/
env/
__pycache__/
.pytest_cache/
.mypy_cache/
*.tsbuildinfo
*.pyc
*.pyo
*.pyd
*.exe
*.msi

# --- Logs and Temp Files ---
*.log
logs/
.cache/
*.tmp
*.temp
*.swp
*.swo
*~

# --- Documentation ---
**/doc/
**/android_transition_docs/

# --- IDE and OS Files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
